# Never let real secrets or local state into a build layer. Even though the
# runtime stage does not copy them, an intermediate layer keeps whatever
# `COPY . .` saw, and that layer is visible in `docker history`.
.env
.env.*
!.env.example
data/

node_modules/
.next/
.git/
.gitignore

*.tsbuildinfo
next-env.d.ts
Dockerfile
.dockerignore
docker-compose.yml
README.md
docs/
