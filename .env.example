# ---------------------------------------------------------------------------
# Database — pick one
# ---------------------------------------------------------------------------
DB_DIALECT=sqlite
SQLITE_PATH=./data/local-cert.db

# DB_DIALECT=postgres
# DATABASE_URL=postgres://localcert:secret@localhost:5432/localcert
# PG_POOL_MAX=10
# PGSSL=require

# ---------------------------------------------------------------------------
# Secrets — generate real values, never ship these
#   openssl rand -base64 32   -> MASTER_KEY (must decode to exactly 32 bytes)
#   openssl rand -base64 48   -> JWT_SECRET
# ---------------------------------------------------------------------------
MASTER_KEY=
JWT_SECRET=
WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Environment
#   Drives two things: the password policy and the default ACME directory.
#     production  -> policy enforced, ACME defaults to the real CA
#     development -> no policy, ACME defaults to staging
#   Falls back to NODE_ENV when unset.
# ---------------------------------------------------------------------------
APP_ENV=development

# ---------------------------------------------------------------------------
# ACME
#   Leave ACME_ENV unset to follow APP_ENV. Setting it wins in both directions —
#   useful to run a production build against staging while validating a zone.
#   Production rate limits are 50 certificates per registered domain per week
#   and they are unforgiving.
# ---------------------------------------------------------------------------
# ACME_ENV=staging
ACME_EMAIL=you@example.com
# ACME_DIRECTORY_URL=https://acme-v02.api.letsencrypt.org/directory

# ---------------------------------------------------------------------------
# ACME server (/acme/directory)
#   ACME clients sign the exact URL they call, so the server must know its own
#   public origin. Leave unset to derive it from X-Forwarded-Proto /
#   X-Forwarded-Host (or Host); set it when the reverse proxy does not forward
#   them. No trailing slash, no path.
# ---------------------------------------------------------------------------
# PUBLIC_URL=https://certs.home.example.com

# ---------------------------------------------------------------------------
# DNS providers declared in the environment (all optional)
#   A provider is the account at a DNS host (AWS, OVHcloud, Gandi, GoDaddy,
#   Google Cloud) that a set of domains is managed with. Providers
#   are normally created in the console (Providers page); declare one here when
#   its credentials must come from the deployment rather than the database.
#
#     PROVIDER_AWS_<KEY>_NAME               required — declares the provider
#     PROVIDER_AWS_<KEY>_ACCESS_KEY_ID      optional pair; without it the
#     PROVIDER_AWS_<KEY>_SECRET_ACCESS_KEY  process credentials are used (below)
#     PROVIDER_AWS_<KEY>_ROLE_ARN           optional IAM role to assume
#     PROVIDER_AWS_<KEY>_REGION             optional, defaults to us-east-1
#
#   <KEY> is a label of your choice (DEFAULT, PROD, LAB…); repeat the block with
#   another label for each additional account. Environment providers show up in
#   the console but cannot be edited or removed there, and their secret is never
#   written to the database. DEFAULT is special in one way: domains registered
#   before providers existed are attached to it at boot.
# ---------------------------------------------------------------------------
PROVIDER_AWS_DEFAULT_NAME="Default AWS"
# PROVIDER_AWS_DEFAULT_ACCESS_KEY_ID=
# PROVIDER_AWS_DEFAULT_SECRET_ACCESS_KEY=
# PROVIDER_AWS_DEFAULT_ROLE_ARN=arn:aws:iam::123456789012:role/local-cert-dns
# PROVIDER_AWS_DEFAULT_REGION=us-east-1

# PROVIDER_AWS_PROD_NAME="aws-prod"
# PROVIDER_AWS_PROD_ACCESS_KEY_ID=
# PROVIDER_AWS_PROD_SECRET_ACCESS_KEY=
# PROVIDER_AWS_PROD_ROLE_ARN=

# Other DNS hosts follow the same pattern, PROVIDER_<HOST>_<KEY>_<FIELD>:
#
# PROVIDER_OVH_PERSO_NAME="ovh-perso"
# PROVIDER_OVH_PERSO_ENDPOINT=ovh-eu            # ovh-eu | ovh-ca | ovh-us
# PROVIDER_OVH_PERSO_APPLICATION_KEY=
# PROVIDER_OVH_PERSO_APPLICATION_SECRET=
# PROVIDER_OVH_PERSO_CONSUMER_KEY=
#
# PROVIDER_GANDI_MAIN_NAME="gandi"
# PROVIDER_GANDI_MAIN_TOKEN=                    # Personal Access Token
#
# PROVIDER_GODADDY_MAIN_NAME="godaddy"
# PROVIDER_GODADDY_MAIN_API_KEY=
# PROVIDER_GODADDY_MAIN_API_SECRET=
#
# PROVIDER_GCP_MAIN_NAME="gcp"
# PROVIDER_GCP_MAIN_SERVICE_ACCOUNT_JSON=       # the key file's JSON, or its base64
# PROVIDER_GCP_MAIN_PROJECT_ID=                 # optional, defaults to the key's project

# Process credentials — the standard AWS chain (these variables, a profile,
# IRSA, an instance role). Only used by providers that carry no key pair.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_PROFILE=local-cert

# ---------------------------------------------------------------------------
# Admin account (optional)
#   Set these to provision the administrator without the /setup wizard — the
#   first boot creates the account and skips the wizard permanently.
#   Leave them empty and the console will ask once, at /setup.
#   ADMIN_API_KEY is optional: without it a key is minted and printed once.
# ---------------------------------------------------------------------------
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=                  # must satisfy the APP_ENV policy; argon2id-hashed at rest
# ADMIN_API_KEY=                   # optional, 24 characters minimum

# ---------------------------------------------------------------------------
# Runtime
# ---------------------------------------------------------------------------
# Companion TXT ownership markers (_local-cert.<name>). Set to 0 to stamp
# provenance only in the Route53 ChangeBatch comment / CloudTrail.
TAG_RECORDS=1
JWT_TTL_SECONDS=3600
SESSION_TTL_SECONDS=28800
WORKER_POLL_MS=10000
WORKER_CONCURRENCY=2
RENEW_SWEEP_MS=21600000
# DISABLE_WORKER=1
